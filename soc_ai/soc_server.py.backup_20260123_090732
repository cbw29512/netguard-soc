#!/usr/bin/env python3
"""
NetGuard SOC Web Server - CODE REVIEWED
VERIFIED: Only serves real data from pipeline files
No simulation, no placeholders, no fake data generation
"""
from flask import Flask, render_template, jsonify
from flask_socketio import SocketIO, emit
import sys
from pathlib import Path
from threading import Thread
import time

sys.path.insert(0, '/opt/netguard/sensors/lib')
from safe_json import read_json_safe

app = Flask(__name__)
app.config['SECRET_KEY'] = 'netguard-soc-real-data-v2'
socketio = SocketIO(app, cors_allowed_origins="*")

# VERIFIED: All paths point to REAL pipeline output files
TELEMETRY = Path("/var/lib/netguard/router_telemetry.json")
FINDINGS = Path("/var/lib/netguard/router_findings.json")
SYSLOG = Path("/var/lib/netguard/router_syslog_findings.json")
INVENTORY = Path("/var/lib/netguard/router_inventory.json")
HEALTH = Path("/var/lib/netguard/health.json")
AI_STATE = Path("/var/lib/netguard/ai_guard_state.json")

@app.route('/')
def index():
    return render_template('soc_dashboard.html')

@app.route('/api/status')
def api_status():
    """
    REVIEWED: Return REAL system status
    VERIFIED: Reads from actual pipeline files
    """
    telemetry = read_json_safe(TELEMETRY, {})
    findings = read_json_safe(FINDINGS, {})
    health = read_json_safe(HEALTH, {})
    ai_state = read_json_safe(AI_STATE, {})
    
    return jsonify({
        'telemetry_ok': telemetry.get('ok', False),
        'active_alerts': len(findings.get('alerts', [])),
        'health_status': health.get('status', 'unknown'),
        'ai_active': len(ai_state.get('thoughts', [])) > 0,
        'last_update': telemetry.get('generated_at', 'unknown')
    })

@app.route('/api/devices')
def api_devices():
    """
    REVIEWED: Return REAL active devices
    VERIFIED: Only returns actual DHCP leases from router
    """
    telemetry = read_json_safe(TELEMETRY, {})
    findings = read_json_safe(FINDINGS, {})
    inventory = read_json_safe(INVENTORY, {})
    
    if not telemetry.get('ok'):
        return jsonify({
            'devices': [],
            'count': 0,
            'error': telemetry.get('error', 'Telemetry unavailable')
        })
    
    # VERIFIED: Extract REAL DHCP leases
    clients = telemetry.get('clients', {}) or {}
    leases = clients.get('dhcp_leases', []) or []
    arp = clients.get('arp', []) or []
    
    # VERIFIED: Get REAL inventory
    reservations = inventory.get('reservations', []) or []
    
    # Build device list from REAL data
    devices = []
    for lease in leases:
        mac = lease.get('mac', '').lower()
        if not mac:
            continue
        
        ip = lease.get('ip', '')
        hostname = lease.get('hostname', 'Unknown')
        
        # Check against REAL inventory
        reserved = next(
            (r for r in reservations if r.get('mac', '').lower() == mac),
            None
        )
        
        # Find REAL alerts for this device
        device_alerts = []
        for alert in findings.get('alerts', []) or []:
            alert_str = str(alert)
            if mac in alert_str or ip in alert_str:
                device_alerts.append(alert)
        
        # Check REAL ARP status
        arp_entry = next(
            (a for a in arp if a.get('mac', '').lower() == mac),
            None
        )
        
        devices.append({
            'mac': mac,
            'ip': ip,
            'hostname': hostname,
            'known': reserved is not None,
            'reserved_name': reserved.get('name', '') if reserved else '',
            'reachable': arp_entry is not None,
            'alerts': device_alerts,
            'alert_count': len(device_alerts)
        })
    
    return jsonify({
        'devices': devices,
        'count': len(devices)
    })

@app.route('/api/ai_thoughts')
def api_ai_thoughts():
    """
    REVIEWED: Return REAL AI thoughts
    VERIFIED: Only returns actual AI observations, no fake data
    """
    ai_state = read_json_safe(AI_STATE, {})
    thoughts = ai_state.get('thoughts', []) or []
    
    return jsonify({
        'thoughts': thoughts[-30:],  # Last 30 thoughts
        'total': len(thoughts),
        'ollama_active': ai_state.get('ollama_available', False)
    })

def broadcast_updates():
    """Push real-time updates to connected clients"""
    while True:
        time.sleep(2)
        
        try:
            devices_data = api_devices().get_json()
            thoughts_data = api_ai_thoughts().get_json()
            status_data = api_status().get_json()
            
            socketio.emit('update_devices', devices_data)
            socketio.emit('update_thoughts', thoughts_data)
            socketio.emit('update_status', status_data)
        except Exception as e:
            print(f"Broadcast error: {e}")

@socketio.on('connect')
def handle_connect():
    print("Client connected to real data stream")
    emit('connected', {'status': 'Connected - Real Data Only'})

if __name__ == '__main__':
    Thread(target=broadcast_updates, daemon=True).start()
    socketio.run(app, host='0.0.0.0', port=8055, debug=False, allow_unsafe_werkzeug=True)
