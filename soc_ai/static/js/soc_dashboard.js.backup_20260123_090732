const socket = io();

socket.on('connect', () => {
    console.log('Connected to NetGuard SOC AI');
});

socket.on('update_thoughts', (data) => {
    const thoughts = data.thoughts || [];
    if (thoughts.length === 0) {
        document.getElementById('aiThoughts').innerHTML = 
            '<span class="thought">🤖 AI Guard watching... No thoughts yet.</span>';
        return;
    }
    
    const marquee = document.getElementById('aiThoughts');
    marquee.innerHTML = thoughts.map(t => 
        `<span class="thought">${t.thought}</span>`
    ).join('');
});

socket.on('update_devices', (data) => {
    const devices = data.devices || [];
    const grid = document.getElementById('deviceGrid');
    
    if (devices.length === 0) {
        if (data.error) {
            grid.innerHTML = `<div class="loading-message">⚠️ ${data.error}</div>`;
        } else {
            grid.innerHTML = '<div class="loading-message">📡 No active devices detected</div>';
        }
        return;
    }
    
    grid.innerHTML = devices.map(device => {
        const alertClass = device.alert_count > 0 ? 'alert' : '';
        const unknownClass = !device.known ? 'unknown' : '';
        const badgeClass = device.alert_count > 0 ? 'badge-alert' : 
                           device.known ? 'badge-known' : 'badge-unknown';
        const badgeText = device.alert_count > 0 ? `⚠️ ${device.alert_count} ALERT` :
                         device.known ? '✓ KNOWN' : '❓ UNKNOWN';
        
        let alertsHtml = '';
        if (device.alerts && device.alerts.length > 0) {
            alertsHtml = `
                <div class="device-alerts">
                    ${device.alerts.map(a => `<div>🚨 ${a.kind}: ${a.severity}</div>`).join('')}
                </div>
            `;
        }
        
        return `
            <div class="device-card ${alertClass} ${unknownClass}">
                <div class="device-header">
                    <div class="device-hostname">${device.hostname}</div>
                    <div class="device-badge ${badgeClass}">${badgeText}</div>
                </div>
                <div class="device-info">
                    <div><span class="label">IP:</span><span class="value">${device.ip}</span></div>
                    <div><span class="label">MAC:</span><span class="value">${device.mac}</span></div>
                    ${device.reserved_name ? `<div><span class="label">NAME:</span><span class="value">${device.reserved_name}</span></div>` : ''}
                    <div><span class="label">STATUS:</span><span class="value">${device.reachable ? '🟢 ONLINE' : '🔴 OFFLINE'}</span></div>
                </div>
                ${alertsHtml}
            </div>
        `;
    }).join('');
});

socket.on('update_status', (data) => {
    const telemetryEl = document.getElementById('statusTelemetry');
    telemetryEl.innerHTML = `TELEMETRY: <span class="${data.telemetry_ok ? 'ok' : 'error'}">${data.telemetry_ok ? '✓ OK' : '✗ FAIL'}</span>`;
    
    const aiEl = document.getElementById('statusAI');
    aiEl.innerHTML = `AI GUARD: <span class="${data.ai_active ? 'ok' : 'error'}">${data.ai_active ? '✓ ACTIVE' : '✗ INACTIVE'}</span>`;
    
    const healthEl = document.getElementById('statusHealth');
    const healthOk = data.health_status === 'healthy';
    healthEl.innerHTML = `HEALTH: <span class="${healthOk ? 'ok' : 'error'}">${data.health_status.toUpperCase()}</span>`;
    
    const updateEl = document.getElementById('statusUpdate');
    if (data.last_update) {
        const time = new Date(data.last_update).toLocaleTimeString();
        updateEl.innerHTML = `LAST UPDATE: <span class="ok">${time}</span>`;
    }
    
    updateProcess('procTelemetry', data.telemetry_ok);
    updateProcess('procAI', data.ai_active);
    updateProcess('procHealth', healthOk);
    updateProcess('procSyslog', true);
    updateProcess('procAnomaly', true);
});

function updateProcess(id, active) {
    const el = document.getElementById(id);
    if (active) {
        el.classList.add('active');
        el.classList.remove('error');
    } else {
        el.classList.remove('active');
        el.classList.add('error');
    }
}
