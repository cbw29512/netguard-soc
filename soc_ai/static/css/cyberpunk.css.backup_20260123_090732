@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap');

:root {
    --cyber-pink: #ff00ff;
    --cyber-cyan: #00ffff;
    --cyber-yellow: #ffff00;
    --cyber-green: #00ff00;
    --cyber-red: #ff0000;
    --cyber-bg: #0a0a0a;
    --cyber-card-bg: #1a1a2e;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Orbitron', sans-serif;
    background: var(--cyber-bg);
    color: var(--cyber-cyan);
    overflow-x: hidden;
    min-height: 100vh;
}

.marquee-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(90deg, #ff00ff 0%, #00ffff 100%);
    padding: 15px 0;
    z-index: 1000;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(255, 0, 255, 0.5);
}

.marquee-content {
    display: flex;
    animation: marquee 30s linear infinite;
    white-space: nowrap;
}

.thought {
    display: inline-block;
    font-size: 18px;
    font-weight: 700;
    color: #000;
    margin-right: 100px;
    text-shadow: 0 0 10px #fff;
}

@keyframes marquee {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
}

.dashboard {
    margin-top: 70px;
    margin-bottom: 80px;
    padding: 20px;
}

.header {
    text-align: center;
    margin-bottom: 30px;
}

.header h1 {
    font-size: 48px;
    font-weight: 900;
    color: var(--cyber-cyan);
    text-shadow: 0 0 20px var(--cyber-cyan), 0 0 40px var(--cyber-pink);
    letter-spacing: 8px;
}

.subtitle {
    font-size: 14px;
    color: var(--cyber-green);
    margin-top: 10px;
    letter-spacing: 2px;
    text-shadow: 0 0 10px var(--cyber-green);
}

.status-bar {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
    font-family: 'Share Tech Mono', monospace;
    flex-wrap: wrap;
}

.status-item {
    font-size: 14px;
    font-weight: 700;
    padding: 8px 15px;
    background: rgba(0, 255, 255, 0.1);
    border: 2px solid var(--cyber-cyan);
    border-radius: 5px;
}

.status-item .ok { color: var(--cyber-green); }
.status-item .error { color: var(--cyber-red); }
.status-item .loading { color: var(--cyber-yellow); animation: pulse 1s infinite; }

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 20px 0;
}

.loading-message {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 20px;
    color: var(--cyber-yellow);
    padding: 40px;
}

.device-card {
    background: var(--cyber-card-bg);
    border: 3px solid var(--cyber-cyan);
    border-radius: 10px;
    padding: 20px;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
}

.device-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.6);
}

.device-card.alert {
    border-color: var(--cyber-red);
    animation: alert-pulse 1s infinite;
}

@keyframes alert-pulse {
    0%, 100% { box-shadow: 0 0 20px rgba(255, 0, 0, 0.5); }
    50% { box-shadow: 0 0 40px rgba(255, 0, 0, 1); }
}

.device-card.unknown {
    border-color: var(--cyber-yellow);
}

.device-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.device-hostname {
    font-size: 20px;
    font-weight: 700;
    color: var(--cyber-cyan);
}

.device-badge {
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
}

.badge-known { background: var(--cyber-green); color: #000; }
.badge-unknown { background: var(--cyber-yellow); color: #000; }
.badge-alert { background: var(--cyber-red); color: #fff; animation: blink 1s infinite; }

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

.device-info {
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    line-height: 1.8;
}

.device-info div {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom: 1px solid rgba(0, 255, 255, 0.2);
}

.device-info .label {
    color: var(--cyber-pink);
    font-weight: 700;
}

.device-info .value {
    color: var(--cyber-cyan);
}

.device-alerts {
    margin-top: 15px;
    padding: 10px;
    background: rgba(255, 0, 0, 0.1);
    border-left: 4px solid var(--cyber-red);
    font-size: 12px;
}

.footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%);
    padding: 15px 20px;
    border-top: 3px solid var(--cyber-cyan);
    box-shadow: 0 -4px 20px rgba(0, 255, 255, 0.3);
    z-index: 999;
}

.process-status {
    display: flex;
    justify-content: space-around;
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    font-weight: 700;
}

.process {
    padding: 8px 20px;
    background: rgba(0, 255, 255, 0.1);
    border: 2px solid var(--cyber-cyan);
    border-radius: 5px;
    transition: all 0.3s ease;
}

.process.active {
    background: rgba(0, 255, 0, 0.2);
    border-color: var(--cyber-green);
    box-shadow: 0 0 15px var(--cyber-green);
}

.process.error {
    background: rgba(255, 0, 0, 0.2);
    border-color: var(--cyber-red);
    box-shadow: 0 0 15px var(--cyber-red);
}

@media (max-width: 768px) {
    .header h1 { font-size: 32px; }
    .device-grid { grid-template-columns: 1fr; }
    .status-bar { flex-direction: column; gap: 10px; }
}
