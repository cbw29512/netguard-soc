<div class="ng-router-box" id="ngRouterSentinel">
  <div class="ng-router-title">Router Sentinel (Live)</div>
  <div class="ng-router-small ng-muted">Last refresh: <span id="ngRouterLast">never</span></div>

  <div class="ng-router-grid">
    <div class="ng-router-card">
      <div class="ng-router-title">Risk</div>
      <div class="ng-router-small">Level: <b id="ngRiskLevel">?</b> &nbsp; Score: <b id="ngRiskScore">?</b></div>
      <div class="ng-router-small">Telemetry age: <b id="ngAgeTel">?</b>s &nbsp; Findings age: <b id="ngAgeFind">?</b>s &nbsp; AI age: <b id="ngAgeAi">?</b>s</div>
    </div>
    <div class="ng-router-card">
      <div class="ng-router-title">Counts</div>
      <div class="ng-router-small">Leases: <b id="ngLeases">?</b> &nbsp; Unknown: <b id="ngUnknown">?</b> &nbsp; Drift: <b id="ngDrift">?</b> &nbsp; Off-LAN: <b id="ngOfflan">?</b></div>
      <div class="ng-router-small">Wi-Fi assoc: wl0=<b id="ngWl0">?</b> wl1=<b id="ngWl1">?</b> wl2=<b id="ngWl2">?</b></div>
    </div>
  </div>

  <details style="margin-top:10px;">
    <summary class="ng-router-small">Alerts / Recommended actions</summary>
    <div class="ng-pre" id="ngAlerts">Loading…</div>
    <div class="ng-pre" id="ngActions">Loading…</div>
  </details>
</div>

<div class="ng-footer" id="ngFooter">
  <div class="ng-pill ng-muted" id="ngFooterVersion">SOC v?</div>
  <div class="ng-pill ng-muted">Services:</div>
  <div class="ng-flex" id="ngFooterPills"><span class="ng-pill ng-warn">Loading…</span></div>
  <div class="ng-pill ng-muted" style="margin-left:auto;">Footer refresh: <span id="ngFooterLast">never</span></div>
</div>

<script>
(function(){
  function fmtAge(x){ if(x===null||x===undefined) return "?"; const n=Math.round(Number(x)); return Number.isFinite(n)?String(n):"?"; }
  function isoNow(){ return new Date().toISOString(); }
  function pillClass(active){ if(active==="active") return "ng-up"; if(active==="inactive"||active==="failed") return "ng-down"; return "ng-warn"; }

  async function pollRouter(){
    try{
      const r=await fetch("/api/router",{cache:"no-store"});
      if(!r.ok) throw new Error("router api http "+r.status);
      const j=await r.json();
      document.getElementById("ngRouterLast").textContent=isoNow();
      document.getElementById("ngRiskLevel").textContent=(j.summary&&j.summary.risk_level)||"?";
      document.getElementById("ngRiskScore").textContent=(j.summary&&j.summary.risk)??"?";
      const st=(j.summary&&j.summary.stale)||{};
      document.getElementById("ngAgeTel").textContent=fmtAge(st.telemetry_age_s);
      document.getElementById("ngAgeFind").textContent=fmtAge(st.findings_age_s);
      document.getElementById("ngAgeAi").textContent=fmtAge(st.ai_age_s);

      const summ=(j.summary&&j.summary.summary)||{};
      document.getElementById("ngLeases").textContent=summ.dhcp_leases??"?";
      document.getElementById("ngUnknown").textContent=summ.unknown_count??"?";
      document.getElementById("ngDrift").textContent=summ.drift_count??"?";
      document.getElementById("ngOfflan").textContent=summ.off_lan_count??"?";
      const wifi=summ.wifi_assoc||{};
      document.getElementById("ngWl0").textContent=(wifi.wl0??"?");
      document.getElementById("ngWl1").textContent=(wifi.wl1??"?");
      document.getElementById("ngWl2").textContent=(wifi.wl2??"?");

      const alerts=(j.summary&&j.summary.alerts)||[];
      document.getElementById("ngAlerts").textContent=JSON.stringify(alerts,null,2);
      const ai=(j.router&&j.router.ai)||{};
      const actions=ai.recommended_actions||[];
      document.getElementById("ngActions").textContent=JSON.stringify(actions,null,2);

      const v=(j.soc_version||"").trim();
      if(v) document.getElementById("ngFooterVersion").textContent="SOC v"+v;
    }catch(e){
      document.getElementById("ngRouterLast").textContent="ERROR";
      document.getElementById("ngAlerts").textContent=String(e);
    }
  }

  async function pollServices(){
    try{
      const r=await fetch("/api/services",{cache:"no-store"});
      if(!r.ok) throw new Error("services api http "+r.status);
      const j=await r.json();
      document.getElementById("ngFooterLast").textContent=isoNow();
      const v=(j.soc_version||"").trim();
      if(v) document.getElementById("ngFooterVersion").textContent="SOC v"+v;

      const host=document.getElementById("ngFooterPills");
      host.innerHTML="";
      const units=j.units||[];
      for(const u of units){
        const span=document.createElement("span");
        span.className="ng-pill "+pillClass(u.active);
        span.title=(u.desc?u.desc+" ":"")+(u.sub?("("+u.sub+")"):"");
        span.textContent=u.unit.replace(".service","").replace(".timer","")+":"+ (u.active||"unknown");
        host.appendChild(span);
      }
      if(units.length===0){
        const span=document.createElement("span");
        span.className="ng-pill ng-warn";
        span.textContent="No units configured";
        host.appendChild(span);
      }
    }catch(e){
      document.getElementById("ngFooterLast").textContent="ERROR";
      const host=document.getElementById("ngFooterPills");
      host.innerHTML="";
      const span=document.createElement("span");
      span.className="ng-pill ng-down";
      span.textContent="services ERROR";
      span.title=String(e);
      host.appendChild(span);
    }
  }

  pollRouter(); pollServices();
  setInterval(pollRouter, 5000);
  setInterval(pollServices, 4000);
})();
</script>



<!-- NETGUARD_STICKY_FOOTER_PILLS_V1 -->
<!-- patched v2: self-healing footer renderer -->
<style>
  .ng-sticky-footer-row{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap}
  .ng-svc-pill{font-family:system-ui,Segoe UI,Roboto,Arial,sans-serif;font-size:12px;letter-spacing:.2px;
               padding:6px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.18);
               background:rgba(0,0,0,.35);backdrop-filter:blur(6px);user-select:none}
  .ng-svc-pill.up{outline:1px solid rgba(0,255,120,.20)}
  .ng-svc-pill.down{outline:1px solid rgba(255,70,70,.25)}
  .ng-svc-pill .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px;vertical-align:middle}
  .ng-svc-pill.up .dot{background:rgba(0,255,120,.85)}
  .ng-svc-pill.down .dot{background:rgba(255,70,70,.9)}
</style>
<script>
(() => {
  function toArray(json){
    if (Array.isArray(json)) return json;
    if (json && Array.isArray(json.services)) return json.services;
    if (json && Array.isArray(json.data)) return json.data;
    return [];
  }
  function isUp(s){
    if (s && typeof s.ok === 'boolean') return s.ok;
    if (s && typeof s.up === 'boolean') return s.up;
    const st = String((s && (s.status || s.state)) || '').toLowerCase();
    return ['ok','up','healthy','running','pass','active'].includes(st);
  }
  function label(s){
    const name = (s && (s.display || s.name || s.service || s.id || s.title)) || 'service';
    const st = (s && (s.status || s.state)) ? String(s.status || s.state) : (isUp(s) ? 'UP' : 'DOWN');
    return `${name}: ${st}`;
  }

  function ensureFooterRow(){
    let footer = document.querySelector('.sticky-footer') || document.querySelector('#stickyFooter') || document.querySelector('footer');
    if (!footer){
      footer = document.createElement('div');
      footer.className = 'sticky-footer';
      footer.style.position = 'fixed';
      footer.style.left = '0';
      footer.style.right = '0';
      footer.style.bottom = '0';
      footer.style.zIndex = '9999';
      footer.style.padding = '10px 12px';
      footer.style.background = 'rgba(0,0,0,.55)';
      document.body.appendChild(footer);
    }

    let row = document.getElementById('ngStickyFooterRow');
    if (!row || !footer.contains(row)){
      // Something overwrote the footer; rebuild it.
      footer.innerHTML = '';
      row = document.createElement('div');
      row.id = 'ngStickyFooterRow';
      row.className = 'ng-sticky-footer-row';
      footer.appendChild(row);
    }
    return row;
  }

  async function tick(){
    const row = ensureFooterRow();
    try{
      const r = await fetch('/api/services', {cache:'no-store'});
      const j = await r.json();
      const services = toArray(j);

      row.innerHTML = '';
      for (const svc of services){
        const pill = document.createElement('span');
        const up = isUp(svc);
        pill.className = 'ng-svc-pill ' + (up ? 'up' : 'down');

        const dot = document.createElement('span');
        dot.className = 'dot';
        pill.appendChild(dot);

        const text = document.createElement('span');
        text.textContent = label(svc);
        pill.appendChild(text);

        row.appendChild(pill);
      }

      if (services.length === 0){
        row.innerHTML = '<span class="ng-svc-pill down"><span class="dot"></span><span>No services returned</span></span>';
      }
    } catch(e){
      row.innerHTML = '<span class="ng-svc-pill down"><span class="dot"></span><span>Services: ERROR</span></span>';
    }
  }

  tick();
  setInterval(tick, 2000);
})();
</script>

