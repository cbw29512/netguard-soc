<div id="ngAlertsModal">
  <div class="backdrop"></div>
  <div class="panel" role="dialog" aria-modal="true">
    <div class="topbar">
      <div class="title">🚨 Alerts & AI Findings</div>
      <div style="display:flex; gap:10px; align-items:center;">
        <div id="ngAlertsSummary" style="font-size:12px; opacity:.85;"></div>
        <div class="btn" id="ngAlertsClose">Close</div>
      </div>
    </div>
    <div class="list" id="ngAlertsList"></div>
  </div>
</div>

<script>
(function(){
  const API_ALERTS = "/api/alerts";

  function el(tag, cls){ const e=document.createElement(tag); if(cls) e.className=cls; return e; }

  function ensureFooterAlertsPill(){
    const footerRow = document.querySelector('.ng-sticky-footer-row');
    if(!footerRow) return null;

    let pill = document.getElementById('ngAlertsPill');
    if(pill) return pill;

    pill = el('div','ng-svc-pill ng-alert-pill');
    pill.id = "ngAlertsPill";
    pill.title = "Open Alerts panel";
    pill.innerHTML = '<span class="dot"></span><span>ALERTS</span><span class="count" id="ngAlertsCount">0</span>';
    footerRow.appendChild(pill);
    pill.addEventListener('click', () => openAlerts());
    return pill;
  }

  function showModal(show){
    const m = document.getElementById('ngAlertsModal');
    if(!m) return;
    m.style.display = show ? 'block' : 'none';
  }

  function openAlerts(){
    showModal(true);
    refreshAlerts(true);
  }

  function closeAlerts(){
    showModal(false);
  }

  function statusSortKey(s){
    s=(s||"open").toLowerCase();
    if(s==="open") return 0;
    if(s==="approved") return 1;
    if(s==="dismissed") return 2;
    if(s==="deleted") return 3;
    return 9;
  }

  async function postJson(url, body){
    const r = await fetch(url, {
      method:"POST",
      headers: {"Content-Type":"application/json"},
      body: body ? JSON.stringify(body) : "{}",
      cache:"no-store"
    });
    const t = await r.text();
    try{ return JSON.parse(t); } catch(e){ return {ok:false, error:"non-json", raw:t, status:r.status}; }
  }

  function dotClass(level){
    level=(level||"info").toLowerCase();
    if(level==="critical") return "critical";
    if(level==="error") return "error";
    if(level==="warning") return "warning";
    if(level==="suggestion") return "suggestion";
    return "info";
  }

  async function askAI(a){
    const id = a.id;
    const out = await postJson(`/api/alerts/${id}/ask_ai`, {
      title: a.title, detail: a.detail, level: a.level, source: a.source
    });
    return out;
  }

  async function refreshAlerts(forceRender){
    const pill = ensureFooterAlertsPill();
    let data = null;
    try{
      const r = await fetch(API_ALERTS, {cache:"no-store"});
      const t = await r.text();
      data = JSON.parse(t);
    }catch(e){
      // if API fails, still show something
      if(pill){
        pill.classList.remove("hot","warm");
        const c = document.getElementById('ngAlertsCount');
        if(c) c.textContent = "?";
      }
      return;
    }

    const alerts = (data.alerts || []).slice().sort((a,b)=>statusSortKey(a.status)-statusSortKey(b.status));
    const openCount = Number(data.open_count || 0);

    // Update pill count + severity styling
    if(pill){
      const c = document.getElementById('ngAlertsCount');
      if(c) c.textContent = String(openCount);
      pill.classList.remove("hot","warm");
      if(openCount >= 3) pill.classList.add("hot");
      else if(openCount >= 1) pill.classList.add("warm");
    }

    // Update summary
    const summary = document.getElementById('ngAlertsSummary');
    if(summary){
      summary.textContent = `${openCount} actionable open • ${alerts.length} total`;
    }

    // Render modal list if open (or forced)
    const modal = document.getElementById('ngAlertsModal');
    const isOpen = modal && modal.style.display !== "none";
    if(!isOpen && !forceRender) return;

    const list = document.getElementById('ngAlertsList');
    if(!list) return;
    list.innerHTML = "";

    if(alerts.length === 0){
      const empty = el('div','ngAlertRow');
      empty.textContent = "No alerts right now.";
      list.appendChild(empty);
      return;
    }

    for(const a of alerts){
      const row = el('div','ngAlertRow');

      const head = el('div','ngAlertHead');
      const meta = el('div','ngAlertMeta');

      const title = el('div','ngAlertTitle');
      title.textContent = a.title || a.detail || "(untitled)";

      const sub = el('div','ngAlertSub');
      const lvl = (a.level||"info").toUpperCase();
      const src = (a.source||"").toString();
      const ts  = (a.timestamp||"").toString();
      const st  = (a.status||"open").toString();
      const needs = a.requires_admin ? " • ADMIN" : "";
      sub.innerHTML = `<span class="ngAlertBadge"><span class="ngDot ${dotClass(a.level)}"></span>${lvl}</span> • ${src}${needs} • <span class="ngStatusPill">${st}</span> • ${ts}`;

      meta.appendChild(title);
      meta.appendChild(sub);

      const actions = el('div','ngAlertActions');

      // Admin approve (only if requires_admin and still open)
      if(a.requires_admin && (a.status||"open")==="open"){
        const b = el('div','btn'); b.textContent="Admin approval";
        b.addEventListener('click', async ()=>{
          await postJson(`/api/alerts/${a.id}/approve`, {title:a.title,detail:a.detail,level:a.level,source:a.source});
          refreshAlerts(true);
        });
        actions.appendChild(b);
      }

      // Ask AI
      const aiBtn = el('div','btn'); aiBtn.textContent="Ask AI";
      aiBtn.addEventListener('click', async ()=>{
        aiBtn.textContent="Asking…";
        const out = await askAI(a);
        aiBtn.textContent="Ask AI";
        if(out && out.ai_detail){
          refreshAlerts(true);
        }
      });
      actions.appendChild(aiBtn);

      // Dismiss
      const dis = el('div','btn'); dis.textContent="Dismiss";
      dis.addEventListener('click', async ()=>{
        await postJson(`/api/alerts/${a.id}/dismiss`, {title:a.title,detail:a.detail,level:a.level,source:a.source});
        refreshAlerts(true);
      });
      actions.appendChild(dis);

      // Reset
      const rst = el('div','btn'); rst.textContent="Reset";
      rst.addEventListener('click', async ()=>{
        await postJson(`/api/alerts/${a.id}/reset`, {title:a.title,detail:a.detail,level:a.level,source:a.source});
        refreshAlerts(true);
      });
      actions.appendChild(rst);

      // Delete
      const del = el('div','btn'); del.textContent="Delete";
      del.addEventListener('click', async ()=>{
        await postJson(`/api/alerts/${a.id}/delete`, {title:a.title,detail:a.detail,level:a.level,source:a.source});
        refreshAlerts(true);
      });
      actions.appendChild(del);

      head.appendChild(meta);
      head.appendChild(actions);

      const body = el('div','ngAlertBody');
      body.textContent = a.detail || "";

      row.appendChild(head);
      row.appendChild(body);

      if(a.ai_detail){
        const ai = el('div','ngAIDetail');
        ai.textContent = a.ai_detail;
        row.appendChild(ai);
      }

      list.appendChild(row);
    }
  }

  // Wire modal close
  document.addEventListener('DOMContentLoaded', ()=>{
    ensureFooterAlertsPill();
    const m = document.getElementById('ngAlertsModal');
    const close = document.getElementById('ngAlertsClose');
    if(close) close.addEventListener('click', closeAlerts);
    if(m){
      const bd = m.querySelector('.backdrop');
      if(bd) bd.addEventListener('click', closeAlerts);
      document.addEventListener('keydown', (e)=>{ if(e.key==="Escape") closeAlerts(); });
    }
    // initial refresh + periodic updates
    refreshAlerts(false);
    setInterval(()=>refreshAlerts(false), 5000);
  });
})();
</script>


<!-- NETGUARD_ALERTS_FETCH_REWRITE_V6 -->
<script>
(function(){
  const _origFetch = window.fetch.bind(window);

  function _tryJsonBody(init){
    try{
      if(!init || !init.body) return {};
      if(typeof init.body === "string") return JSON.parse(init.body);
    }catch(e){}
    return {};
  }

  window.fetch = async function(resource, init){
    try{
      const url = (typeof resource === "string") ? resource : (resource && resource.url) ? resource.url : "";
      const m = url.match(/\/api\/alerts\/([^\/]+)\/(approve|dismiss|reset|ai_detail)(\b|\?)/i);
      if(m){
        const id = m[1];
        const action = m[2].toLowerCase();
        const bodyObj = _tryJsonBody(init);
        const payload = Object.assign({id, action}, bodyObj);

        return _origFetch("/api/alerts_action", {
          method: "POST",
          headers: {"Content-Type":"application/json"},
          body: JSON.stringify(payload),
          cache: "no-store"
        });
      }
    }catch(e){}
    return _origFetch(resource, init);
  };
})();
</script>

