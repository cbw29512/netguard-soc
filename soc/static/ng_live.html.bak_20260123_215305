<button id="ngAlertsBtn" title="Open Alerts">
  ALERTS
  <span id="ngAlertsBadge">0</span>
</button>

<div id="ngAlertsModal" class="ng-hidden" role="dialog" aria-modal="true" aria-label="Alerts">
  <div class="ng-alerts-card">
    <div class="ng-alerts-top">
      <div style="display:flex; align-items:baseline; gap:10px;">
        <h3>NetGuard Alerts</h3>
        <div class="ng-sub" id="ngAlertsSub">Loading…</div>
      </div>
      <button class="ng-alerts-close" id="ngAlertsClose">Close</button>
    </div>
    <div class="ng-alerts-body" id="ngAlertsList"></div>
  </div>
</div>

<script>
(function(){
  const btn = document.getElementById("ngAlertsBtn");
  const badge = document.getElementById("ngAlertsBadge");
  const modal = document.getElementById("ngAlertsModal");
  const closeBtn = document.getElementById("ngAlertsClose");
  const list = document.getElementById("ngAlertsList");
  const sub = document.getElementById("ngAlertsSub");

  let lastPayload = null;

  function esc(s){ return (s||"").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  async function apiGetAlerts(){
    const r = await fetch("/api/alerts", {cache:"no-store"});
    if(!r.ok) throw new Error("alerts http " + r.status);
    return await r.json();
  }
  async function apiPost(path){
    const r = await fetch(path, {method:"POST", headers:{"Content-Type":"application/json"}, body:"{}"});
    if(!r.ok) throw new Error("post http " + r.status);
    return await r.json();
  }

  function render(payload){
    lastPayload = payload;
    const alerts = (payload && payload.alerts) ? payload.alerts : [];
    const openCount = (payload && typeof payload.open_count === "number")
      ? payload.open_count
      : alerts.filter(a => (a.status||"open")==="open").length;

    badge.textContent = String(openCount);
    sub.textContent = `${openCount} open • ${alerts.length} total`;

    list.innerHTML = alerts.map(a => {
      const lvl = (a.level||"warning").toLowerCase();
      const status = (a.status||"open").toLowerCase();
      const requiresAdmin = !!a.requires_admin;
      const id = a.id;

      const meta = `${esc(a.source||"")}${a.timestamp ? " • "+esc(a.timestamp) : ""}${status!=="open" ? " • "+esc(status) : ""}`;
      const detail = esc(a.detail||"");

      const aiDetail = a.ai_detail ? esc(JSON.stringify(a.ai_detail, null, 2)) : "";

      const adminBtn = (requiresAdmin && status==="open")
        ? `<button class="ng-btn good" data-act="approve" data-id="${id}">Admin Approval</button>`
        : "";

      return `
        <div class="ng-alert" data-id="${id}">
          <div class="ng-alert-head">
            <div class="ng-alert-left" style="min-width:0;">
              <span class="ng-pill ${lvl}">${esc(lvl)}</span>
              <div style="min-width:0;">
                <div class="ng-alert-title">${esc(a.title||"(untitled alert)")}</div>
                <div class="ng-alert-meta">${meta}</div>
              </div>
            </div>

            <div class="ng-alert-actions">
              <button class="ng-btn info" data-act="ai" data-id="${id}">Ask AI</button>
              <button class="ng-btn" data-act="reset" data-id="${id}">Reset</button>
              ${adminBtn}
              <button class="ng-btn" data-act="dismiss" data-id="${id}">Dismiss</button>
              <button class="ng-btn danger" data-act="delete" data-id="${id}">Delete</button>
            </div>
          </div>

          <div class="ng-alert-detail">
DETAIL:
${detail}

${a.ai_detail ? "AI_DETAIL:\n"+aiDetail : "(No AI detail yet — click “Ask AI”.)"}
          </div>
        </div>
      `;
    }).join("");

    if(alerts.length === 0){
      list.innerHTML = `<div style="opacity:.75; font-family:system-ui,Segoe UI,Roboto,Arial,sans-serif; padding:12px;">
        No alerts right now. 🎉
      </div>`;
    }
  }

  async function refresh(){
    try{
      const payload = await apiGetAlerts();
      render(payload);
    }catch(e){
      sub.textContent = "Alerts API error — check /api/alerts";
      // keep badge unchanged if API down
      console.warn(e);
    }
  }

  // Click handlers
  btn.addEventListener("click", async () => {
    modal.classList.remove("ng-hidden");
    await refresh();
  });
  closeBtn.addEventListener("click", () => modal.classList.add("ng-hidden"));
  modal.addEventListener("click", (e) => { if(e.target === modal) modal.classList.add("ng-hidden"); });

  list.addEventListener("click", async (e) => {
    const b = e.target.closest("button[data-act]");
    if(!b) return;
    const act = b.getAttribute("data-act");
    const id = b.getAttribute("data-id");
    try{
      if(act === "dismiss") await apiPost(`/api/alerts/${id}/dismiss`);
      if(act === "delete")  await apiPost(`/api/alerts/${id}/delete`);
      if(act === "reset")   await apiPost(`/api/alerts/${id}/reset`);
      if(act === "approve") await apiPost(`/api/alerts/${id}/approve`);
      if(act === "ai")      await apiPost(`/api/alerts/${id}/ai_expand`);
      await refresh();
    }catch(err){
      console.error(err);
      sub.textContent = "Action failed — check SOC logs";
    }
  });

  // Background badge refresh (so you see count change without opening modal)
  setInterval(async () => {
    try{
      const payload = await apiGetAlerts();
      const openCount = (payload && typeof payload.open_count === "number")
        ? payload.open_count
        : (payload.alerts||[]).filter(a => (a.status||"open")==="open").length;
      badge.textContent = String(openCount);
    }catch(_){}
  }, 2500);

  // initial badge load
  refresh();
})();
</script>


