#!/usr/bin/env python3
import os, re, json, sqlite3, time
from pathlib import Path
from datetime import datetime, timezone, timedelta

OUT_DIR = Path("/var/lib/netguard")
LOG     = Path("/var/log/asus-router/router.log")
DB      = Path(os.environ.get("NG_SYSLOG_DB", str(OUT_DIR/"router_syslog.sqlite")))
STATE   = Path(os.environ.get("NG_SYSLOG_STATE", str(OUT_DIR/"router_syslog.offset")))
OUTJSON = Path(os.environ.get("NG_SYSLOG_OUT", str(OUT_DIR/"router_syslog_findings.json")))

ROUTER_IP = os.environ.get("NG_ROUTER_IP", "192.168.50.1")
NUC_IP    = os.environ.get("NG_NUC_IP", "192.168.50.50")

LINE = re.compile(r'^(?P<ts>\S+)\s+(?P<host>\S+)\s+(?P<prog>[^\[]+)\[(?P<pid>\d+)\]:\s+(?P<msg>.*)$')

DROPBEAR_CHILD = re.compile(r'Child connection from (?P<srcip>\d+\.\d+\.\d+\.\d+):(?P<srcport>\d+)')
DROPBEAR_FAIL  = re.compile(r'(?i)(bad password|password auth failed|login failed|permission denied)')
PUBKEY_OK      = re.compile(r'Pubkey auth succeeded')

def utc_now():
    return datetime.now(timezone.utc)

def ensure_db(conn: sqlite3.Connection) -> None:
    conn.execute("""
      CREATE TABLE IF NOT EXISTS events (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        ts TEXT,
        host TEXT,
        prog TEXT,
        pid INTEGER,
        msg TEXT,
        raw TEXT
      )
    """)
    conn.execute("CREATE INDEX IF NOT EXISTS idx_events_ts ON events(ts)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_events_prog ON events(prog)")
    conn.commit()

def read_offset() -> int:
    try:
        s = STATE.read_text().strip()
        return int(s) if s else 0
    except Exception:
        return 0

def write_offset(n: int) -> None:
    STATE.write_text(str(n))

def parse_line(line: str):
    m = LINE.match(line.strip())
    if not m:
        return None
    d = m.groupdict()
    # keep pid as int
    try:
        d["pid"] = int(d["pid"])
    except Exception:
        d["pid"] = 0
    d["raw"] = line.rstrip("\n")
    return d

def ingest():
    LOG.parent.mkdir(parents=True, exist_ok=True)
    STATE.parent.mkdir(parents=True, exist_ok=True)

    off = read_offset()
    data = LOG.read_bytes()
    if off > len(data):
        # log rotated/truncated
        off = 0

    new = data[off:]
    if not new:
        return 0

    lines = new.decode("utf-8", errors="replace").splitlines(True)
    parsed = []
    for ln in lines:
        d = parse_line(ln)
        if d:
            parsed.append(d)

    if parsed:
        conn = sqlite3.connect(DB)
        ensure_db(conn)
        conn.executemany(
            "INSERT INTO events(ts,host,prog,pid,msg,raw) VALUES (?,?,?,?,?,?)",
            [(d["ts"], d["host"], d["prog"].strip(), d["pid"], d["msg"], d["raw"]) for d in parsed]
        )
        conn.commit()
        conn.close()

    write_offset(len(data))
    return len(parsed)

def summarize(window_minutes: int = 10):
    since = utc_now() - timedelta(minutes=window_minutes)
    conn = sqlite3.connect(DB)
    ensure_db(conn)

    rows = conn.execute(
        "SELECT ts,host,prog,pid,msg FROM events ORDER BY id DESC LIMIT 2000"
    ).fetchall()
    conn.close()

    # Only keep window (router timestamps are local-offset strings; we treat them as text window approx)
    # For now: analyze last 2000 lines and build stats/alerts heuristically.
    counts = {}
    alerts = []
    recent = []
    for ts, host, prog, pid, msg in rows:
        prog = (prog or "").strip()
        counts[prog] = counts.get(prog, 0) + 1
        recent.append((ts, host, prog, msg))

        if prog == "dropbear":
            m = DROPBEAR_CHILD.search(msg)
            if m:
                srcip = m.group("srcip")
                if srcip != NUC_IP:
                    alerts.append({
                        "severity": "high",
                        "kind": "ssh_connection_not_from_nuc",
                        "src_ip": srcip,
                        "msg": msg
                    })
            if DROPBEAR_FAIL.search(msg):
                alerts.append({
                    "severity": "high",
                    "kind": "ssh_auth_failure",
                    "msg": msg
                })

    # simple top programs
    top = sorted(counts.items(), key=lambda x: x[1], reverse=True)[:12]

    out = {
        "generated_at": utc_now().isoformat(),
        "ok": True,
        "error": "",
        "window_minutes_hint": window_minutes,
        "summary": {
            "top_programs": [{"program": k, "count": v} for k, v in top],
            "recent_sample": [
                {"ts": ts, "host": host, "program": prog, "msg": msg}
                for ts, host, prog, msg in recent[:20]
            ],
        },
        "alerts": alerts[:50]
    }
    OUTJSON.write_text(json.dumps(out, indent=2))

def main():
    try:
        n = ingest()
        summarize(10)
        print(json.dumps({"ok": True, "ingested": n, "out": str(OUTJSON)}))
    except Exception as e:
        OUTJSON.write_text(json.dumps({
            "generated_at": utc_now().isoformat(),
            "ok": False,
            "error": str(e),
            "alerts": []
        }, indent=2))
        print(json.dumps({"ok": False, "error": str(e)}))

if __name__ == "__main__":
    main()
