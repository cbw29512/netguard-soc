#!/usr/bin/env python3
import json, os, re, sqlite3, subprocess
from datetime import datetime, timezone
from pathlib import Path

OUT_JSON = Path(os.environ.get("OUT_JSON", "/var/lib/netguard/router_telemetry.json"))
DB_PATH  = Path(os.environ.get("DB", "/var/lib/netguard/router_telemetry.sqlite"))

ROUTER_HOST = os.environ.get("ROUTER_HOST", "192.168.50.1").strip()
ROUTER_USER = os.environ.get("ROUTER_USER", "nucboxr").strip()

KEY   = os.environ.get("KEY_PATH", "/var/lib/netguard/keys/netguard_router_ed25519").strip()
KNOWN = os.environ.get("KNOWN_HOSTS", "/var/lib/netguard/ssh_known_hosts").strip()

SSH_BASE = [
    "ssh",
    "-i", KEY,
    "-o", f"UserKnownHostsFile={KNOWN}",
    "-o", "StrictHostKeyChecking=yes",
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=5",
    "-o", "PreferredAuthentications=publickey",
]

MAC_RE = re.compile(r"([0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5})")

def utc_now_iso():
    return datetime.now(timezone.utc).isoformat()

def run_ssh(cmd: str) -> str:
    full = SSH_BASE + [f"{ROUTER_USER}@{ROUTER_HOST}", cmd]
    p = subprocess.run(full, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if p.returncode != 0:
        raise RuntimeError(f"ssh rc={p.returncode}: {p.stderr.strip()}")
    return p.stdout

def parse_dnsmasq_leases(text: str):
    # expiry mac ip hostname clientid
    out = []
    for line in (text or "").splitlines():
        line = line.strip()
        if not line: 
            continue
        parts = line.split()
        if len(parts) < 4:
            continue
        expiry = int(parts[0]) if parts[0].isdigit() else None
        mac = parts[1].lower()
        ip  = parts[2]
        host = parts[3] if parts[3] != "*" else ""
        cid = parts[4] if len(parts) >= 5 else ""
        out.append({"expiry_epoch": expiry, "mac": mac, "ip": ip, "hostname": host, "clientid": cid})
    return out

def parse_arp(text: str):
    # /proc/net/arp
    out = []
    lines = (text or "").splitlines()
    for line in lines[1:]:
        cols = line.split()
        if len(cols) < 6:
            continue
        ip, hw_type, flags, mac, mask, dev = cols[:6]
        out.append({"ip": ip, "mac": mac.lower(), "dev": dev, "flags": flags})
    return out

def parse_proc_net_dev(text: str):
    # /proc/net/dev
    out = {}
    lines = (text or "").splitlines()
    for line in lines[2:]:
        if ":" not in line:
            continue
        iface, rest = line.split(":", 1)
        iface = iface.strip()
        vals = rest.split()
        if len(vals) < 16:
            continue
        rx_bytes, rx_pkts, rx_err, rx_drop = map(int, vals[0:4])
        tx_bytes, tx_pkts, tx_err, tx_drop = map(int, vals[8:12])
        out[iface] = {
            "rx_bytes": rx_bytes, "rx_pkts": rx_pkts, "rx_err": rx_err, "rx_drop": rx_drop,
            "tx_bytes": tx_bytes, "tx_pkts": tx_pkts, "tx_err": tx_err, "tx_drop": tx_drop,
        }
    return out

def parse_assoclist(text: str):
    macs = []
    for line in (text or "").splitlines():
        m = MAC_RE.search(line)
        if m:
            macs.append(m.group(1).lower())
    # de-dupe preserving order
    seen=set(); out=[]
    for m in macs:
        if m not in seen:
            seen.add(m); out.append(m)
    return out

def ensure_db():
    con = sqlite3.connect(str(DB_PATH))
    con.execute("PRAGMA journal_mode=WAL;")
    con.execute("""
      CREATE TABLE IF NOT EXISTS router_samples (
        ts TEXT PRIMARY KEY,
        json TEXT NOT NULL
      );
    """)
    con.commit()
    con.close()

def insert_sample(ts: str, payload: dict):
    con = sqlite3.connect(str(DB_PATH))
    con.execute("PRAGMA journal_mode=WAL;")
    con.execute("INSERT OR REPLACE INTO router_samples(ts,json) VALUES(?,?)", (ts, json.dumps(payload)))
    con.commit()
    con.close()

def main():
    out = {
        "generated_at": utc_now_iso(),
        "router_host": ROUTER_HOST,
        "router_user": ROUTER_USER,
        "ok": False,
        "error": "",
        "router": {},
        "clients": {},
        "wifi": {"bands": {}},
        "net": {},
    }

    try:
        # Router health
        out["router"]["uname"]   = run_ssh("uname -a 2>/dev/null || cat /proc/version 2>/dev/null || true").strip()
        out["router"]["uptime"]  = run_ssh("uptime 2>/dev/null || cat /proc/uptime 2>/dev/null || true").strip()
        out["router"]["loadavg"] = run_ssh("cat /proc/loadavg 2>/dev/null || true").strip()
        out["router"]["meminfo"] = run_ssh("cat /proc/meminfo 2>/dev/null | head -n 60 || true")

        # Clients: DHCP + ARP
        leases_txt = run_ssh("cat /var/lib/misc/dnsmasq.leases 2>/dev/null || true")
        arp_txt    = run_ssh("cat /proc/net/arp 2>/dev/null || true")
        out["clients"]["dhcp_leases"] = parse_dnsmasq_leases(leases_txt)
        out["clients"]["arp_table"]   = parse_arp(arp_txt)

        # Wi-Fi ifnames
        wl0 = run_ssh("nvram get wl0_ifname 2>/dev/null || true").strip()
        wl1 = run_ssh("nvram get wl1_ifname 2>/dev/null || true").strip()
        wl2 = run_ssh("nvram get wl2_ifname 2>/dev/null || true").strip()
        out["wifi"]["wl_ifnames"] = {"wl0": wl0, "wl1": wl1, "wl2": wl2}

        # Assoc lists via 'wl' (Broadcom tool on ASUS)
        for band, ifn in (("wl0", wl0), ("wl1", wl1), ("wl2", wl2)):
            band_obj = {"ifname": ifn, "assoc_macs": [], "note": ""}
            if not ifn:
                band_obj["note"] = "ifname empty"
            else:
                # if wl missing, this will just return empty
                txt = run_ssh(f"command -v wl >/dev/null 2>&1 && wl -i {ifn} assoclist 2>/dev/null || true")
                band_obj["assoc_macs"] = parse_assoclist(txt)
                if not band_obj["assoc_macs"]:
                    band_obj["note"] = "no assoc_macs (or wl unsupported for this band)"
            out["wifi"]["bands"][band] = band_obj

        # Conntrack count/max
        ct_count = run_ssh("cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo ''").strip()
        ct_max   = run_ssh("cat /proc/sys/net/netfilter/nf_conntrack_max   2>/dev/null || echo ''").strip()
        try:
            out["net"]["conntrack"] = {"count": int(ct_count), "max": int(ct_max)}
        except Exception:
            out["net"]["conntrack"] = {"count": None, "max": None}

        # Interface counters (drops/errors)
        dev_txt = run_ssh("cat /proc/net/dev 2>/dev/null || true")
        out["net"]["if_counters"] = parse_proc_net_dev(dev_txt)

        out["ok"] = True

    except Exception as e:
        out["ok"] = False
        out["error"] = str(e)

    # write atomically
    tmp = OUT_JSON.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(out, indent=2), encoding="utf-8")
    tmp.replace(OUT_JSON)

    # store history even if ok=false (useful for debugging)
    ensure_db()
    insert_sample(out["generated_at"], out)

    print(json.dumps({"ok": out["ok"], "generated_at": out["generated_at"], "error": out["error"][:120]}))

if __name__ == "__main__":
    main()
