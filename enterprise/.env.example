# NetGuard enterprise local environment template.
# Copy to enterprise/.env locally and fill secrets with strong random values.
# Never commit enterprise/.env.

INFLUXDB_IMAGE=influxdb:2.7
INFLUXDB_INIT_USERNAME=netguard
INFLUXDB_INIT_PASSWORD=
INFLUXDB_INIT_ORG=netguard
INFLUXDB_INIT_BUCKET=network_stats
INFLUXDB_INIT_ADMIN_TOKEN=

GRAFANA_IMAGE=grafana/grafana:13.2
GRAFANA_ADMIN_USER=netguard-admin
GRAFANA_ADMIN_PASSWORD=
