<!DOCTYPE html>
<html>
<head>
    <title>NetGuard SOC | Tactical</title>
    <style>
        :root { --bg: #05070a; --accent: #38bdf8; --ok: #4ade80; --bad: #f43f5e; }
        body { background: var(--bg); color: #f8fafc; font-family: 'Segoe UI', sans-serif; margin: 0; padding-bottom: 70px; overflow: hidden; }
        header { background: #1e293b; padding: 15px; border-bottom: 4px solid var(--accent); font-weight: 900; font-size: 18px; }
        .container { display: grid; grid-template-columns: 1fr 450px; gap: 20px; padding: 20px; height: 85vh; }
        .panel { background: #0f172a; border: 3px solid #334155; border-radius: 8px; padding: 15px; display: flex; flex-direction: column; }
        .panel h3 { font-size: 20px; font-weight: 900; color: var(--accent); margin-bottom: 15px; border-bottom: 2px solid #334155; padding-bottom: 8px; }
        .ip-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; overflow-y: auto; }
        .card { background: #1e293b; border: 3px solid var(--accent); border-radius: 8px; padding: 15px; cursor: pointer; transition: 0.1s; }
        .card:hover { transform: scale(1.02); border-color: #fff; box-shadow: 0 0 15px var(--accent); }
        .stream { font-family: 'Courier New', monospace; font-size: 14px; font-weight: 900; color: var(--ok); background: #000; padding: 12px; height: 100%; overflow-y: auto; line-height: 1.6; }
        #overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #05070a; z-index: 9999; padding: 100px; text-align: center; }
    </style>
</head>
<body>
    <div id="overlay" onclick="this.style.display='none'">
        <h1 id="ov-ip" style="font-size: 80px; color: var(--accent);">0.0.0.0</h1>
        <div style="font-size: 150px; font-weight: 900; color: var(--ok);" id="ov-data">0K</div>
        <p style="font-size: 24px; color: var(--bad);">[ CLICK ANYWHERE TO CLOSE ]</p>
    </div>
    <header id="ai-thought">>>> INITIALIZING BROAD SPECTRUM TACTICAL LINK...</header>
    <div class="container">
        <div class="left-col"><div class="panel" style="height:100%"><h3>Tactical Grid (Cards)</h3><div class="ip-grid" id="ip-container"></div></div></div>
        <div class="right-col">
            <div class="panel" style="height:40%"><h3>Mirror Flow Log</h3><div class="stream" id="stream-mirror">LISTENING...</div></div>
            <div class="panel" style="height:58%; margin-top:10px"><h3>Wi-Fi Intelligence (2.4/5G)</h3><div class="stream" id="stream-wifi">SCANNING...</div></div>
        </div>
    </div>
    <script>
        async function refresh() {
            try {
                const s = await (await fetch('/api/state')).json();
                if (s.ip_cards && s.ip_cards.length > 0) {
                    document.getElementById('ip-container').innerHTML = s.ip_cards.map(c => `
                        <div class="card" onclick="openDetail('${c.ip}', ${c.up+c.down})">
                            <span style="font-size:22px; font-weight:900;">Node-${c.ip.split('.').pop()}</span><br>
                            <span style="color:var(--accent); font-weight:bold;">${c.ip}</span>
                            <div style="color:var(--bad); font-weight:900; margin-top:15px; font-size:16px;">UP: ${(c.up/1024).toFixed(1)}K</div>
                            <div style="color:var(--ok); font-weight:900; font-size:16px;">DN: ${(c.down/1024).toFixed(1)}K</div>
                        </div>`).join('');
                    document.getElementById('stream-mirror').innerText = s.ip_cards.slice(0,10).map(c => `[FLOW] ${c.ip.padEnd(15)} | ${((c.up+c.down)/1024).toFixed(1)}K total`).join('\n');
                }
                const w = await (await fetch('/api/wifi_scan')).json();
                if (w.networks) document.getElementById('stream-wifi').innerText = w.networks.map(n=>`[${n.signal_dbm}dBm] ${n.band}G | CH:${n.channel} | ${n.ssid}`).join('\n');
                const a = await (await fetch('/api/ai_thoughts')).json();
                if (a.lines) document.getElementById('ai-thought').innerText = ">>> " + a.lines[a.lines.length-1].toUpperCase();
            } catch(e) { console.error(e); }
        }
        function openDetail(ip, val) {
            document.getElementById('ov-ip').innerText = "DRILL-DOWN: " + ip;
            document.getElementById('ov-data').innerText = (val/1024).toFixed(1) + "K";
            document.getElementById('overlay').style.display = 'block';
        }
        setInterval(refresh, 2000); refresh();
    </script>
</body>
</html>
